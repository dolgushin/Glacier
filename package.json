{
  "name": "glacier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-ca.mjs dev",
    "build": "next build",
    "start": "node scripts/with-ca.mjs start",
    "lint": "next lint",
    "seed": "node --import ./scripts/register-alias.mjs scripts/seed.ts",
    "test": "node --import ./scripts/register-alias.mjs --test tests/xirr.test.ts tests/positions.test.ts tests/csv.test.ts tests/brokers.test.ts tests/alor.test.ts tests/derivatives.test.ts tests/summary.test.ts tests/scheduler.test.ts tests/tax.test.ts tests/twr.test.ts tests/attribution.test.ts tests/telegram.test.ts tests/dividends.test.ts",
    "sync:once": "node scripts/autosync.mjs --once",
    "sync:watch": "node scripts/autosync.mjs",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop.ps1"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.8.3"
  }
}
