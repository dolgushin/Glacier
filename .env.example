# Скопируйте в .env и заполните.

# Путь к файлу базы. По умолчанию ./data/glacier.db
GLACIER_DB_PATH=./data/glacier.db

# Ключ шифрования брокерских токенов. Обязателен в production.
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ВНИМАНИЕ: при смене ключа ранее сохранённые токены брокера перестанут расшифровываться
# и подключения нужно будет создать заново.
GLACIER_SECRET=

# Необязательно: ключ demo-тарифа CoinGecko, если упрётесь в лимит бесплатных запросов.
COINGECKO_API_KEY=

# Автосинхронизация брокеров (npm run sync:watch / sync:once).
# Интервал опроса в минутах. По умолчанию 60, меньше 5 не принимается.
GLACIER_SYNC_INTERVAL_MINUTES=60

# Секрет для POST /api/cron/sync — триггера автосинхронизации из системного cron.
# Пустое значение полностью выключает эндпоинт (он отвечает 404).
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GLACIER_CRON_SECRET=

# Telegram-бот для уведомлений (новые выплаты, сбои синхронизации, /week).
# Токен от @BotFather. Пустое значение выключает бота и прячет блок в настройках.
GLACIER_TELEGRAM_TOKEN=

# Секрет вебхука Telegram (заголовок X-Telegram-Bot-Api-Secret-Token).
# Регистрация вебхука одной командой:
#   curl "https://api.telegram.org/bot$GLACIER_TELEGRAM_TOKEN/setWebhook" \
#     -d url=https://<хост>/api/telegram -d secret_token=<это значение>
GLACIER_TELEGRAM_WEBHOOK_SECRET=

# ОБЯЗАТЕЛЬНО для синхронизации с Т-Инвестициями.
# Их API отдаёт сертификат российского УЦ Минцифры, которому Node.js не доверяет,
# и соединение обрывается с SELF_SIGNED_CERT_IN_CHAIN.
# Скачайте корневой сертификат в формате PEM на https://www.gosuslugi.ru/crt
# и укажите путь к нему. Переменную читает сам Node при старте процесса.
# NODE_EXTRA_CA_CERTS=./certs/russian-trusted-root.pem
